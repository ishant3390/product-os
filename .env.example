# ==============================================================================
# ProductOS Environment Configuration
# ==============================================================================

# Backend API Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Persistence (Supabase PostgreSQL or fallback SQLite)
# Leave empty to use zero-config local SQLite: sqlite:///./productos.db
SUPABASE_URL=
SUPABASE_KEY=
DATABASE_URL=sqlite:///./productos.db

# LLM Provider Configuration (LiteLLM supports any of these)
# Provide at least one key to enable live AI Copilot reasoning:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Default LLM Model Identifiers
COPIOT_FAST_MODEL=gemini/gemini-2.0-flash
COPIOT_REASONING_MODEL=anthropic/claude-3-5-sonnet-20241022

# Personalized MCP Integrations (Configured via UI or env)
SERVICENOW_INSTANCE_URL=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_MODE=sandbox

GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_MODE=sandbox
